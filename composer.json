{
    "name": "paper-leaf/mission-control",
    "description": "Mission Control is the command center for your Laravel application, giving you a clear view of your site's systems, integrations, and environment. Monitor key services, inspect application details, and perform essential maintenance tasks from one convenient location.",
    "keywords": [
        "Paper Leaf",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "mission-control"
    ],
    "homepage": "https://github.com/paper-leaf/mission-control",
    "support": {
        "issues": "https://github.com/paper-leaf/mission-control/issues",
        "source": "https://github.com/paper-leaf/mission-control"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Sarah Tinga",
            "email": "sarah@paper-leaf.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Paper Leaf\\MissionControl\\": "src/",
            "Paper Leaf\\MissionControl\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paper Leaf\\MissionControl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Paper Leaf\\MissionControl\\MissionControlServiceProvider"
            ],
            "aliases": {
                "MissionControl": "Paper Leaf\\MissionControl\\Facades\\MissionControl"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}